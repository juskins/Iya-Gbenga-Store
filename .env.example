# Copy to .env.local and fill in. NEVER commit .env.local.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server only). https://resend.com
RESEND_API_KEY=
# Until your domain is verified use: "Iya Gbenga's Store <onboarding@resend.dev>" (delivers ONLY to your Resend account email)
RESEND_FROM="Iya Gbenga's Store <orders@YOUR_DOMAIN>"
# Optional: where customer replies go
RESEND_REPLY_TO=

# Bank transfer details shown on the confirmation page and in the order email (server only).
# Leave empty until the store provides them: customers are then told "we'll contact you with payment details".
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Store config
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional. Shown on the site and in emails; defaults to the WhatsApp number.
NEXT_PUBLIC_SUPPORT_PHONE=
